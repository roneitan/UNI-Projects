# ─── Agent Provider ──────────────────────────────────────────────────────────
# 'claude' (default) or 'openai' — can also be set per-service in services/*.js
AGENT_PROVIDER=claude

# ─── Claude / Anthropic ──────────────────────────────────────────────────────
# Required when AGENT_PROVIDER=claude (or any service sets provider: 'claude')
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required when AGENT_PROVIDER=openai (or any service sets provider: 'openai')
OPENAI_API_KEY=sk-...

# ─── Microsoft Teams ─────────────────────────────────────────────────────────
# Incoming Webhook URL — Teams channel → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=https://<tenant>.webhook.office.com/webhookb2/...

# ─── Azure DevOps ────────────────────────────────────────────────────────────
# Personal Access Token — generate at:
# https://dev.azure.com/<org>/_usersSettings/tokens
# Required scopes: Code (Read & Write), Build (Read), Test Management (Read)
ADO_MCP_AUTH_TOKEN=<your-pat>

# Organisation name only (e.g. "contoso", not the full URL)
AZURE_DEVOPS_ORG_NAME=your-org

# Default project — can be overridden per service in services/*.js
AZURE_DEVOPS_PROJECT=your-project

# ─── Repos ───────────────────────────────────────────────────────────────────
# Repos are configured per-service in services/*.js
# Auth uses ADO_MCP_AUTH_TOKEN above — no separate repo credentials needed

# ─── App behaviour ───────────────────────────────────────────────────────────
# IANA timezone for cron schedule (02:00 collect+analyze, 07:00 Teams report)
# Examples: UTC  Asia/Jerusalem  America/New_York  Europe/London
TZ=UTC

# Max parallel service agent runs (each spawns a Claude Code process + MCP server)
MAX_CONCURRENT_AGENTS=3
