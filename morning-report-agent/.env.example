# ─── Claude / Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Slack ────────────────────────────────────────────────────────────────────
# Incoming Webhook URL from: Slack App → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ─── Azure DevOps (MCP via stdio transport) ───────────────────────────────────
# Personal Access Token — generate at:
# https://dev.azure.com/<org>/_usersSettings/tokens
AZURE_DEVOPS_PAT=<your-pat>

# Base URL for your Azure DevOps organisation
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org

# Default project name to query
AZURE_DEVOPS_PROJECT=your-project

# Command used to launch the Azure DevOps MCP server (stdio transport).
# Examples:
#   npx -y @azure-devops/mcp@latest
#   /home/user/.local/bin/azure-devops-mcp
AZURE_DEVOPS_MCP_CMD=npx -y @azure-devops/mcp@latest

# ─── Services ─────────────────────────────────────────────────────────────────
# Comma-separated Azure DevOps pipeline definition names, one per service.
# These are the exact pipeline names shown in Azure DevOps Pipelines.
# Example: SERVICES=auth-service-nightly,api-gateway-nightly,data-pipeline-nightly
SERVICES=

# ─── App behaviour ────────────────────────────────────────────────────────────
# IANA timezone for cron schedule (02:00 collect, 07:00 report).
# Examples: UTC  Asia/Jerusalem  America/New_York  Europe/London
TZ=UTC
